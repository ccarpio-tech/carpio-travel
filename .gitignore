# Provider plugins from terraform init (large and machine-specific)
.terraform/

# State files (hold resource IDs and can hold secrets)
*.tfstate
*.tfstate.*

# Saved plan files (can hold secrets)
tfplan
*.tfplan

# Variable files (commit terraform.tfvars.example instead)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log

# .terraform.lock.hcl is NOT ignored (it pins provider versions)

# AWS credentials and secrets
.aws/
*.pem
*.key
.env
.env.*

# macOS and editor files
.DS_Store
.vscode/
.idea/
